# Devin API credentials (required)
# Create a service user at https://app.devin.ai/settings/service-users
DEVIN_API_TOKEN=cog_your_token_here
DEVIN_ORG_ID=your_org_id_here

# GitHub token with issues:write permission on the target repo
GITHUB_TOKEN=ghp_your_token_here

# GitHub webhook secret (optional — skips verification if empty)
GITHUB_WEBHOOK_SECRET=

# Target repository for vulnerability tracking issues
TARGET_REPO=thagikura/superset-fork

# Database URL — SQLite for local, swap to postgresql:// for cloud
DATABASE_URL=sqlite:///data/triage.db
